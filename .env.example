# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/go_hall_of_fame

# Optional. The public address, for links in emails and share previews (no trailing slash).
# On Vercel the production host is used when this is empty.
SITE_URL=http://localhost:3000
# Optional. Password-reset emails go through Resend. Without them, `pnpm dev` prints the reset link
# in the terminal, and production cannot send the email (use `pnpm admin:create` to reset instead).
RESEND_API_KEY=
EMAIL_FROM="Go Hall of Fame <noreply@example.com>"
